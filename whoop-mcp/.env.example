# Copy to .env or export in your shell / MCP client config.
WHOOP_CLIENT_ID=your-client-id
WHOOP_CLIENT_SECRET=your-client-secret
# Must match a redirect URI registered in the WHOOP developer dashboard.
WHOOP_REDIRECT_URI=http://localhost:8765/callback
# Optional: where tokens and the food/weight database live (default ~/.whoop-mcp)
# WHOOP_MCP_HOME=~/.whoop-mcp
